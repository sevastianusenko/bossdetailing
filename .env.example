# Request form delivery. Without these the form returns an honest
# "not connected yet — please call" error instead of pretending to send.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where request emails land.
REQUEST_INBOX=

# Must be a domain verified in Resend. Defaults to requests@autodetailingwa.com.
REQUEST_FROM="Boss Auto Detailing <requests@autodetailingwa.com>"
